<Project Sdk="Microsoft.NET.Sdk">

  <!-- The target framework (net10.0) comes from Directory.Build.props, so the tool needs the .NET 10 runtime. -->
  <PropertyGroup>
    <PackageId>atc-kusto</PackageId>
    <PackageTags>adx;kusto;azure;cli</PackageTags>
    <Description>A .NET Tool that can interact with Azure Data Explorer (Kusto)</Description>
    <Title>ATC Kusto CLI</Title>
    <OutputType>Exe</OutputType>
    <AssemblyName>atc-kusto</AssemblyName>
    <ToolCommandName>atc-kusto</ToolCommandName>
    <PackAsTool>true</PackAsTool>
    <DebugType>pdbonly</DebugType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Link="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Atc" Version="4.0.0" />
    <PackageReference Include="Atc.Console.Spectre" Version="4.0.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageReference Include="Microsoft.Azure.Kusto.Data" Version="14.2.4" />
    <PackageReference Include="Microsoft.Azure.Kusto.Language" Version="12.4.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>