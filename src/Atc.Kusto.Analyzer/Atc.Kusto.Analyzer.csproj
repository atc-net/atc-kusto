<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Roslyn version is the oldest compiler that can load the analyzer, so keep it at 4.14.0 instead of the latest.
         Microsoft.CodeAnalysis.Analyzers only checks this project at build time, so it can stay on the latest version. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="AnalyzerReleases.Shipped.md" />
    <None Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Atc.Kusto.Analyzer.Tests" />
    <InternalsVisibleTo Include="Atc.Kusto.Analyzer.CodeFixes" />
    <InternalsVisibleTo Include="Atc.Kusto.Analyzer.CodeFixes.Tests" />
  </ItemGroup>

</Project>
