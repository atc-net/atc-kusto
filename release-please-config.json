{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-v-in-tag": true,
  "include-component-in-tag": true,
  "tag-separator": "@",
  "separate-pull-requests": true,
  "pull-request-header": ":robot: Preparing to release next version",
  "pull-request-footer": "This pull request was generated by release-please.",
  "packages": {
    "src": {
      "component": "Atc.Kusto",
      "release-type": "simple",
      "changelog-path": "Atc.Kusto/CHANGELOG.md",
      "pull-request-title-pattern": "chore(kusto): release version ${version}",
      "extra-files": ["Directory.Build.props"]
    },
    "src/Atc.Kusto.CLI": {
      "component": "atc-kusto-cli",
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "pull-request-title-pattern": "chore(cli): release version ${version}",
      "extra-files": ["Directory.Build.props"]
    }
  },
  "bootstrap-sha": "2ab93e27e2d0d305c565e42a9214efa553c1b32a",
  "changelog-sections": [
    { "type": "feat", "section": "New features" },
    { "type": "fix", "scope": "deps", "section": "Upgrades" },
    { "type": "fix", "section": "Bug fixes" },
    { "type": "perf", "section": "Performance improvements" },
    { "type": "revert", "section": "Reverts" }
  ]
}
