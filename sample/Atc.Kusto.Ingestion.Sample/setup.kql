// One-time setup for Atc.Kusto.Ingestion.Sample. Run these commands against the target database.

// The table. Column names are camelCase, as in tables typically fed by Event Hubs.
.create-merge table SampleDeviceReadings (
    runId: string,
    scenario: string,
    deviceId: string,
    serialNumber: string,
    value: real,
    timestamp: datetime
)

// The JSON mapping used by the JSON scenarios. Paths are case-sensitive and must match the
// property names the library writes (camelCase by default).
.create-or-alter table SampleDeviceReadings ingestion json mapping "SampleDeviceReadings_mapping"
    '['
        '{"column": "runId", "path": "$.runId"},'
        '{"column": "scenario", "path": "$.scenario"},'
        '{"column": "deviceId", "path": "$.deviceId"},'
        '{"column": "serialNumber", "path": "$.serialNumber"},'
        '{"column": "value", "path": "$.value"},'
        '{"column": "timestamp", "path": "$.timestamp"}'
    ']'

// A second JSON mapping with snake_case paths, used by the scenario whose connection writes
// snake_case names (ConfigureSerializerOptions with JsonNamingPolicy.SnakeCaseLower).
.create-or-alter table SampleDeviceReadings ingestion json mapping "SampleDeviceReadings_snake_case_mapping"
    '['
        '{"column": "runId", "path": "$.run_id"},'
        '{"column": "scenario", "path": "$.scenario"},'
        '{"column": "deviceId", "path": "$.device_id"},'
        '{"column": "serialNumber", "path": "$.serial_number"},'
        '{"column": "value", "path": "$.value"},'
        '{"column": "timestamp", "path": "$.timestamp"}'
    ']'

// Enables real streaming ingestion for the table (streaming must also be enabled on the cluster).
// Without it, ManagedStreaming falls back to queued and the Streaming scenario fails.
.alter table SampleDeviceReadings policy streamingingestion enable

// Optional clean-up afterwards:
// .drop table SampleDeviceReadings