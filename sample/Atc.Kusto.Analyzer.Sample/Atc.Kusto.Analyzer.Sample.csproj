<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Atc.Kusto.Analyzer\Atc.Kusto.Analyzer.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>Analyzer</OutputItemType>
    </ProjectReference>
    <ProjectReference Include="..\..\src\Atc.Kusto.Analyzer.CodeFixes\Atc.Kusto.Analyzer.CodeFixes.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>Analyzer</OutputItemType>
    </ProjectReference>
    <ProjectReference Include="..\..\src\Atc.Kusto\Atc.Kusto.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embeds the .kusto files, which the queries load at runtime -->
    <EmbeddedResource Include="**/*.kusto" />

    <!-- Lets the Atc.Kusto analyzer read the .kusto files -->
    <AdditionalFiles Include="**/*.kusto" />
  </ItemGroup>

</Project>