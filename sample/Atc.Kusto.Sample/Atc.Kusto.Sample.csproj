<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embeds the .kusto files, which the queries load at runtime -->
    <EmbeddedResource Include="**/*.kusto" />

    <!-- Lets the Atc.Kusto analyzer read the .kusto files (it runs when Atc.Kusto comes from the NuGet package) -->
    <AdditionalFiles Include="**/*.kusto" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Atc.Kusto\Atc.Kusto.csproj" />
  </ItemGroup>

</Project>
